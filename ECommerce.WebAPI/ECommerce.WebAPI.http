@ECommerce.WebAPI_HostAddress = https://localhost:7208
@token = YOUR_JWT_TOKEN_HERE

POST {{ECommerce.WebAPI_HostAddress}}/api/categories
Content-Type: application/json

{
  "name": "Cüzdan",
  "description": "Deri cüzdan ürünleri",
  "isActive": true
}
###

GET {{ECommerce.WebAPI_HostAddress}}/api/categories
Accept: application/json

###
POST {{ECommerce.WebAPI_HostAddress}}/api/products
Content-Type: application/json

{
  "name": "Classic Leather Belt",
  "description": "Handmade genuine leather belt",
  "price": 79.90,
  "stock": 20,
  "imageUrl": "classic-leather-belt.jpg",
  "isActive": true,
  "categoryId": 1
}

###
### Update Category
PUT {{ECommerce.WebAPI_HostAddress}}/api/categories/2
Content-Type: application/json

{
  "name": "Leather Wallet",
  "description": "Handmade genuine leather wallets",
  "isActive": true
}

###

GET {{ECommerce.WebAPI_HostAddress}}/api/products
Accept: application/json
### Get Category By Id
GET {{ECommerce.WebAPI_HostAddress}}/api/categories/2
Accept: application/json

###
### Delete Category
DELETE {{ECommerce.WebAPI_HostAddress}}/api/categories/2

  ### Get Product By Id
GET {{ECommerce.WebAPI_HostAddress}}/api/products/2
Accept: application/json

### Update Product
PUT {{ECommerce.WebAPI_HostAddress}}/api/products/2
Content-Type: application/json

{
  "name": "Premium Leather Belt",
  "description": "Premium handmade genuine leather belt",
  "price": 89.90,
  "stock": 15,
  "imageUrl": "premium-leather-belt.jpg",
  "isActive": true,
  "categoryId": 1
}

###  Delete Product
DELETE {{ECommerce.WebAPI_HostAddress}}/api/products/2

### Register User
POST {{ECommerce.WebAPI_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "firstName": "Eser",
  "lastName": "Tepe",
  "email": "eser.test@example.com",
  "password": "Test123!"
}
### Login User
POST {{ECommerce.WebAPI_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "eser.test@example.com",
  "password": "Test123!"
}
### Get All Products
GET {{ECommerce.WebAPI_HostAddress}}/api/products
Accept: application/json
Authorization:Bearer  {{token}}


### Customer ile ürün eklemeyi dene test
POST {{ECommerce.WebAPI_HostAddress}}/api/products
Content-Type: application/json
Authorization: Bearer  {{token}}


{
  "name": "Test Product",
  "description": "Yetki testi",
  "price": 100,
  "stock": 10,
  "imageUrl": "test.jpg",
  "isActive": true,
  "categoryId": 1
}
### Login User
POST {{ECommerce.WebAPI_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "eser.test@example.com",
  "password": "Test123!"
}
### Register Admin
