@using System.Text.Json

@{
    ViewData["Title"] = "Shopping Cart";

    var cartJson = ViewBag.CartJson as string ?? "[]";

    using var document = JsonDocument.Parse(cartJson);

    var items = document.RootElement;

    decimal total = 0;
    bool isGuest = ViewBag.IsGuest == true;
}

<div class="container mt-5 mb-5">

    <h2 class="mb-4">Your Shopping Cart</h2>

    @if (items.GetArrayLength() == 0)
    {
        <div class="alert alert-info">
            Your cart is currently empty.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered align-middle">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Subtotal</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in items.EnumerateArray())
                    {
                        var product = item.GetProperty("product");

                        var name = product.GetProperty("name")
                            .GetString();

                        var price = product.GetProperty("price")
                            .GetDecimal();

                        var quantity = item.GetProperty("quantity")
                            .GetInt32();

                        var cartItemId = item.GetProperty("id")
                            .GetInt32();

                        var subtotal = price * quantity;

                        total += subtotal;

                        <tr>
                            <td>@name</td>

                            <td>@price.ToString("0.00") kr</td>

                            <td>
                                <form asp-controller="Cart"
                                      asp-action="UpdateQuantity"
                                      method="post"
                                      class="d-flex gap-2">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="cartItemId"
                                           value="@cartItemId" />

                                    <input type="number"
                                           name="quantity"
                                           value="@quantity"
                                           min="1"
                                           class="form-control"
                                           style="width:80px;" />

                                    <button type="submit"
                                            class="btn btn-sm"
                                            style="background:#a65f3b;color:white;">
                                        Update
                                    </button>
                                </form>
                            </td>

                            <td>@subtotal.ToString("0.00") kr</td>

                            <td>
                                <form asp-controller="Cart"
                                      asp-action="Remove"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="cartItemId"
                                           value="@cartItemId" />

                                    <button type="submit"
                                            class="btn btn-danger btn-sm">
                                        Remove
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <h4 class="text-end mt-4">
            Total: @total.ToString("0.00") kr
        </h4>
    }

    <div class="d-flex gap-3 mt-4 flex-wrap">

        <a asp-controller="Products"
           asp-action="Index"
           class="btn btn-dark">
            Continue Shopping
        </a>

        @if (items.GetArrayLength() > 0)
        {
            @if (isGuest)
            {
                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn btn-success">
                    Login to Checkout
                </a>
            }
            else
            {
                <a asp-controller="Payment"
                   asp-action="Index"
                   class="btn btn-success">
                    Checkout
                </a>
            }
        }

    </div>

</div>