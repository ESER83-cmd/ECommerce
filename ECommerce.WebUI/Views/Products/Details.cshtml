@model ECommerce.WebUI.Models.ProductViewModel

@{
    ViewData["Title"] = "Product Details";

    var productName = (Model.Name ?? "").ToLowerInvariant();

    var isCardHolder = productName.Contains("card holder");

    var hasColors =
        productName.Contains("wallet") ||
        productName.Contains("belt") ||
        productName.Contains("bracelet") ||
        productName.Contains("keychain") ||
        isCardHolder;

    // Support both full image paths and file names.
    var imageUrl = Model.ImageUrl ?? "";

    if (string.IsNullOrWhiteSpace(imageUrl))
    {
        imageUrl = "/Images/Products/no-image.png";
    }
    else if (imageUrl.StartsWith("~/"))
    {
        imageUrl = Url.Content(imageUrl);
    }
    else if (!imageUrl.StartsWith("/"))
    {
        imageUrl = "/Images/Products/" + imageUrl;
    }
}

<div class="container mt-5">

    <!-- Product Details -->
    <div class="row g-4">

        <!-- Product Image -->
        <div class="col-md-6">

            <img id="productImage"
                 src="@imageUrl"
                 alt="@Model.Name"
                 class="img-fluid rounded shadow-sm"
                 style="width:100%; max-height:450px; object-fit:contain;" />

        </div>

        <!-- Product Information -->
        <div class="col-md-6">

            <h2>@Model.Name</h2>

            <p class="text-muted">
                @Model.Description
            </p>

            <h3 class="mt-3">
                @Model.Price.ToString("0.00") kr
            </h3>

            <p class="mt-3">
                Stock: @Model.Stock
            </p>

            <!-- Color Selection -->
            @if (hasColors)
            {
                <h5 class="mt-4">Select Color</h5>

                <p class="text-muted">
                    Selected Color:
                    <strong id="selectedColor">Brown</strong>
                </p>

                <div class="d-flex gap-2 mb-4 flex-wrap">

                    <button type="button"
                            class="btn btn-dark color-option"
                            data-color="Brown"
                            onclick="changeColor('Brown')">
                        Brown
                    </button>

                    <button type="button"
                            class="btn btn-outline-dark color-option"
                            data-color="Black"
                            onclick="changeColor('Black')">
                        Black
                    </button>

                    <button type="button"
                            class="btn btn-outline-dark color-option"
                            data-color="Green"
                            onclick="changeColor('Green')">
                        Green
                    </button>

                    <button type="button"
                            class="btn btn-outline-dark color-option"
                            data-color="Burgundy"
                            onclick="changeColor('Burgundy')">
                        Burgundy
                    </button>

                </div>
            }

            <!-- Add to Cart -->
            <form asp-controller="Cart"
                  asp-action="Add"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="productId"
                       value="@Model.Id" />

                <button type="submit"
                        class="btn btn-dark btn-lg"
                        disabled="@(Model.Stock <= 0)">
                    Add to Cart
                </button>

            </form>

            <!-- Back to Products -->
            <a asp-controller="Products"
               asp-action="Index"
               class="btn btn-outline-secondary mt-3">
                Back to Products
            </a>

        </div>
    </div>

    <!-- About the Product -->
    <section class="mt-5 pt-4">

        <h3 class="fw-bold mb-4">
            About the Product
        </h3>

        <div class="row g-4">

            <div class="col-md-6">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="fs-4">♧</span>
                    <span>Genuine Leather</span>
                </div>

                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="fs-4">◷</span>
                    <span>4 Seasons</span>
                </div>

                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="fs-4">☁</span>
                    <span>Lightweight</span>
                </div>

            </div>

            <div class="col-md-6">

                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="fs-4">🎁</span>
                    <span>Gift</span>
                </div>

                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="fs-4">⊠</span>
                    <span>Not Washable</span>
                </div>

            </div>

        </div>

    </section>

    <!-- Maintenance Recommendations -->
    <section class="mt-5 mb-5">

        <hr class="mb-5" />

        <h3 class="fw-bold mb-4">
            Maintenance Recommendations
        </h3>

        <p class="text-muted">
            Taking care of your leather products
            can be both effortless and enjoyable.
        </p>

        <p>
            Clean gently with a soft, dry cloth.
            Avoid excessive moisture, direct heat,
            and prolonged exposure to sunlight.
        </p>

        <p>
            Use a suitable leather conditioner
            when necessary to maintain softness
            and durability.
        </p>

        <p>
            Do not machine wash.
            Store in a cool and dry place.
        </p>

    </section>

</div>

@section Scripts {
    <script>
        const productName = @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(Model.Name)
        );

        const defaultImageUrl = @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(imageUrl)
        );

        const productImages = {
            wallet: {
                Brown: "wallet.png",
                Black: "wallet-black.png",
                Green: "wallet-green.png",
                Burgundy: "wallet-burgundy.png"
            },
            belt: {
                Brown: "belt.png",
                Black: "belt-black.png",
                Green: "belt-green.png",
                Burgundy: "belt-burgundy.png"
            },
            bracelet: {
                Brown: "bracelet.png",
                Black: "bracelet-black.png",
                Green: "bracelet-green.png",
                Burgundy: "bracelet-burgundy.png"
            },
            keychain: {
                Brown: "keychain.png",
                Black: "keychain-black.png",
                Green: "keychain-green.png",
                Burgundy: "keychain-burgundy.png"
            },
            "card holder": {
               Brown: "card holders.png",
               Black: "card holders-black.png",
               Green: "card holders-green.png",
               Burgundy: "card holders-burgundy.png"
            }
        };

        function changeColor(color) {

            const name = productName.toLowerCase();

            const productType = Object.keys(productImages)
                .find(type => name.includes(type));

            if (!productType) {
                console.error("Product type not found:", productName);
                return;
            }

            const fileName = productImages[productType][color];

            if (!fileName) {
                console.error("Image not found for color:", color);
                return;
            }

            const image = document.getElementById("productImage");

            if (!image) {
                console.error("Product image element not found.");
                return;
            }

            const newImageUrl = "/Images/Products/" + fileName;

            image.src = newImageUrl;

            const selectedColor = document.getElementById("selectedColor");

            if (selectedColor) {
                selectedColor.textContent = color;
            }

            document.querySelectorAll(".color-option")
                .forEach(button => {

                    const isSelected =
                        button.dataset.color === color;

                    button.classList.toggle("btn-dark", isSelected);
                    button.classList.toggle("btn-outline-dark", !isSelected);
                });
        }
    </script>
}